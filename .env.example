# ─────────────────────────────────────────────────────────────
#  Balloons Decor ZP — приклад змінних оточення
#  Скопіюй цей файл у ".env.local" і заповни своїми значеннями.
#  Файл .env.local НЕ потрапляє в git (він у .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Supabase (база даних + сховище фото) ---
# Знайти тут: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # публічний ключ (anon)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...       # СЕКРЕТНИЙ ключ (service_role) — тільки на сервері!

# --- Адмінка ---
# Пароль для входу в /admin. Придумай складний.
ADMIN_PASSWORD=change-me-please
# Секрет для підпису cookie сесії (будь-який довгий випадковий рядок)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Telegram (заявки з форми) ---
# TELEGRAM_BOT_TOKEN отримаєш у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID — куди слати заявки (твій chat_id або id групи/каналу)
TELEGRAM_CHAT_ID=123456789

# --- Аналітика / реклама (необовʼязково, можна додати пізніше) ---
# Google Analytics 4 / Google Ads
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# --- Загальне ---
NEXT_PUBLIC_SITE_URL=https://balloonsdecor.com.ua
